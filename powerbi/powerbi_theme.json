{
  "name": "AI MarketLens",
  "dataColors": [
    "#3b82d4", "#f59e0b", "#10b981", "#ef4444",
    "#8b5cf6", "#06b6d4", "#f97316", "#84cc16",
    "#ec4899", "#6366f1"
  ],
  "background": "#ffffff",
  "foreground": "#1f2328",
  "tableAccent": "#3b82d4",
  "maximum": "#10b981",
  "minimum": "#ef4444",
  "neutral": "#57606a",
  "backgroundLight": "#f7f8fa",
  "visualStyles": {
    "*": {
      "*": {
        "fontFamily": [{ "value": "Segoe UI" }],
        "fontSize": [{ "value": 11 }]
      }
    },
    "card": {
      "*": {
        "calloutValue": [{ "fontSize": 28, "fontFamily": "Segoe UI", "fontBold": true }],
        "label": [{ "fontSize": 11, "fontFamily": "Segoe UI", "color": { "solid": { "color": "#57606a" } } }],
        "background": [{ "show": true, "color": { "solid": { "color": "#f7f8fa" } } }],
        "border": [{ "show": true, "color": { "solid": { "color": "#e5e7eb" } } }]
      }
    },
    "columnChart": {
      "*": {
        "dataPoint": [{ "defaultColor": { "solid": { "color": "#3b82d4" } } }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#57606a" } }, "showAxisTitle": false }],
        "valueAxis": [{ "labelColor": { "solid": { "color": "#57606a" } } }],
        "background": [{ "show": true, "color": { "solid": { "color": "#ffffff" } } }],
        "border": [{ "show": true, "color": { "solid": { "color": "#e5e7eb" } } }]
      }
    },
    "lineChart": {
      "*": {
        "dataPoint": [{ "defaultColor": { "solid": { "color": "#3b82d4" } } }],
        "lineStyles": [{ "strokeWidth": 2 }]
      }
    },
    "barChart": {
      "*": {
        "dataPoint": [{ "defaultColor": { "solid": { "color": "#3b82d4" } } }]
      }
    },
    "pieChart": {
      "*": {
        "dataPoint": [{ "defaultColor": { "solid": { "color": "#3b82d4" } } }]
      }
    },
    "slicer": {
      "*": {
        "data": [{ "fontColor": { "solid": { "color": "#1f2328" } }, "textSize": 11 }],
        "header": [{ "fontColor": { "solid": { "color": "#3b82d4" } }, "fontBold": true }]
      }
    },
    "tableEx": {
      "*": {
        "header": [{ "fontColor": { "solid": { "color": "#1f2328" } }, "backColor": { "solid": { "color": "#f7f8fa" } }, "fontBold": true }],
        "rows": [{ "fontColor": { "solid": { "color": "#1f2328" } }, "backColor": { "solid": { "color": "#ffffff" } } }]
      }
    }
  }
}
